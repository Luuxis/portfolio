{
  "name": "portfolio",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run db:migrate:remote && wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test 'src/**/*.test.ts'",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply portfolio --local",
    "db:migrate:remote": "wrangler d1 migrations apply portfolio --remote",
    "admin:secrets": "node scripts/admin-secrets.mjs"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.1.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.12.27",
    "postal-mime": "^4.2.1",
    "worker-mailer": "^1.3.1"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "wrangler": "^4.105.0"
  }
}
